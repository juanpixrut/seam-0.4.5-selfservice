# Seam AMS demonstration data: the Accounting & Admin module (docs/ACCOUNTING_ADMIN_MODULE.md).
# A .seed file, format version 2 (docs/SEED_FORMAT.md). It is an addition: it loads over any seed, or alone:
#   python3 seeds/seed.py load accounting --url http://localhost:9090
# Written by cmd/accounting-seedgen, which runs the module's own rules over five months of 2026; do not edit it by
# hand: change the generator and run it again. The dates of the books are fixed, they do not move with the load.
{"seed": 2,
  "name": "accounting",
  "description": "Accounting & Admin: AEs, tenants, collections, commissions, settlements and the books, July to November 2026",
  "tags": ["accounting"],
  "version": "1",
  "addition": true,
  "entities": ["users", "adm_instance", "adm_ae", "adm_account", "adm_company", "adm_formula", "adm_tenant", "adm_item", "adm_document", "adm_commission", "adm_settlement", "adm_entry", "adm_movement", "adm_close", "adm_line_claim"],
  "notes": "6 AEs, 8 tenants, 43 items, 81 journal entries, 5 settlements, 4 monthly closes. Seam must run with the module on (SEAM_ENABLE_ACCOUNTING=1).",
  "x": {"seam": {"logins": [{"email": "accounting.staff@example.com", "password": "holaquetal", "role": "admin_staff"}, {"email": "accountant@example.com", "password": "holaquetal", "role": "accountant"}, {"email": "marta.rivas@example.com", "password": "holaquetal", "role": "account_executive"}, {"email": "diego.suarez@example.com", "password": "holaquetal", "role": "account_executive"}, {"email": "paula.mendez@example.com", "password": "holaquetal", "role": "account_executive"}, {"email": "dev@ual.li", "password": "holaquetal", "role": "developer"}], "module": "accounting"}}}

