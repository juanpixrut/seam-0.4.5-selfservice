# fsm_machines: 2
{"kind": "entity", "entity": "fsm_machines", "id": 1, "data": {
  "description": "Estados de un extintor desde alta hasta destrucción (Decreto 372/023, UNIT 607)",
  "name": "Ciclo de Vida — Extintor",
  "states": [
    {
      "color": "#10b981",
      "is_initial": true,
      "label": "En servicio",
      "name": "en_servicio",
      "transitions": [
        {
          "condition": {"duration": "90d", "type": "duration_exceeded"},
          "priority": 50,
          "to": "inspeccion_pendiente"
        },
        {"condition": {"trigger": "custom_driver", "type": "trigger_type"}, "priority": 70, "to": "en_taller"},
        {
          "condition": {"trigger": "api_call", "type": "trigger_type"},
          "priority": 90,
          "to": "vida_util_excedida"
        }
      ]
    },
    {
      "color": "#f59e0b",
      "label": "Inspección pendiente",
      "name": "inspeccion_pendiente",
      "transitions": [
        {"condition": {"trigger": "qr_scan", "type": "trigger_type"}, "priority": 50, "to": "en_servicio"},
        {"condition": {"trigger": "custom_driver", "type": "trigger_type"}, "priority": 70, "to": "en_taller"}
      ]
    },
    {
      "color": "#3b82f6",
      "label": "En taller (recarga / hidrostático)",
      "name": "en_taller",
      "transitions": [
        {
          "condition": {"trigger": "custom_driver", "type": "trigger_type"},
          "priority": 50,
          "to": "en_servicio"
        },
        {"condition": {"trigger": "custom_driver", "type": "trigger_type"}, "priority": 80, "to": "reprobado"}
      ]
    },
    {
      "color": "#ef4444",
      "label": "Reprobado (no apto)",
      "name": "reprobado",
      "transitions": [{"condition": {"trigger": "api_call", "type": "trigger_type"}, "priority": 50, "to": "dado_de_baja"}]
    },
    {
      "color": "#dc2626",
      "label": "Vida útil excedida (20 años)",
      "name": "vida_util_excedida",
      "transitions": [{"condition": {"trigger": "api_call", "type": "trigger_type"}, "priority": 50, "to": "dado_de_baja"}]
    },
    {
      "color": "#6b7280",
      "is_final": true,
      "label": "Dado de baja (destruido — reportado DNB)",
      "name": "dado_de_baja",
      "transitions": []
    }
  ]
  }}
{"kind": "entity", "entity": "fsm_machines", "id": 2, "data": {
  "description": "Estado de la habilitación de bomberos de un local cliente",
  "name": "Habilitación DNB — Sitio",
  "states": [
    {
      "color": "#10b981",
      "is_initial": true,
      "label": "Vigente",
      "name": "vigente",
      "transitions": [{"condition": {"duration": "60d", "type": "duration_exceeded"}, "priority": 50, "to": "por_vencer"}]
    },
    {
      "color": "#f59e0b",
      "label": "Por vencer (60 días)",
      "name": "por_vencer",
      "transitions": [
        {"condition": {"duration": "0d", "type": "duration_exceeded"}, "priority": 80, "to": "vencida"},
        {"condition": {"trigger": "api_call", "type": "trigger_type"}, "priority": 50, "to": "vigente"}
      ]
    },
    {
      "color": "#ef4444",
      "label": "Vencida",
      "name": "vencida",
      "transitions": [{"condition": {"trigger": "api_call", "type": "trigger_type"}, "priority": 50, "to": "vigente"}]
    }
  ]
  }}

# asset_types: 7
{"kind": "entity", "entity": "asset_types", "id": 1, "data": {
  "color": "#ef4444",
  "connectivity_tiers": ["qr"],
  "default_alerta_id": 0,
  "description": "Extintores manuales a base de polvo químico seco ABC presurizado (UNIT 598). Recarga cada 2 años, ensayo hidrostático cada 4 años, vida útil 20 años.",
  "fsm_id": 1,
  "identity_template": {
    "capacity_kg": {"label": "Capacidad (kg)", "required": true, "type": "number"},
    "dnb_number": {"label": "Nro. aprobación DNB", "required": false, "type": "text"},
    "manufacture_year": {"label": "Año de fabricación", "required": true, "type": "number"},
    "pressure_bar": {"label": "Presión de trabajo (bar)", "required": false, "type": "number"},
    "serial_number": {"label": "Número de serie (cilindro)", "required": true, "type": "text"}
  },
  "name": "Extintor Polvo ABC",
  "slug": "extintor-polvo-abc",
  "state_template": {
    "condition_grade": {"label": "Grado de condición", "required": false, "type": "text"},
    "hose_status": {"label": "Estado manguera/boquilla", "required": false, "type": "text"},
    "pressure_ok": {"label": "Presión en zona verde", "required": false, "type": "boolean"},
