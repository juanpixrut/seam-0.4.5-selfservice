# Entity schemas for the seed 01-constructec: one per entity type, so that xolu validates every record against it.
# Loaded together with the seed by: python3 seeds/seed-01-constructec.py --schemas
{"seed": 2,
  "name": "01-constructec-schemas",
  "description": "Entity schemas for the seed 01-constructec",
  "version": "1",
  "entities": [
    "alert_types",
    "alerts",
    "asset_types",
    "assets",
    "brands",
    "cost_centers",
    "currencies",
    "custodians",
    "events",
    "fsm_machines",
    "locations",
    "models",
    "prop_associations",
    "prop_definitions",
    "regions",
    "rules",
    "sensor_bindings",
    "sensors",
    "tenant_settings",
    "users"
  ]
  }

