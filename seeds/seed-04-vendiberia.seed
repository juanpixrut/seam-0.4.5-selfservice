# fsm_machines: 2
{"kind": "entity", "entity": "fsm_machines", "id": 1, "data": {
  "description": "Estados operativos de una máquina expendedora en campo",
  "name": "Estado Operativo — Máquina Vending",
  "states": [
    {
      "color": "#10b981",
      "is_initial": true,
      "label": "Operativa",
      "name": "operativa",
      "transitions": [
        {
          "condition": {"field": "fill_pct", "threshold": 20, "type": "value_lt"},
          "priority": 50,
          "to": "stock_bajo"
        },
        {
          "condition": {"field": "temp_interior_c", "threshold": 8, "type": "value_gt"},
          "priority": 90,
          "to": "alarma_temperatura"
        },
        {
          "condition": {"trigger": "custom_driver", "type": "trigger_type"},
          "priority": 80,
          "to": "fuera_de_servicio"
        }
      ]
    },
    {
      "color": "#f59e0b",
      "label": "Stock bajo",
      "name": "stock_bajo",
      "transitions": [
        {"condition": {"trigger": "qr_scan", "type": "trigger_type"}, "priority": 50, "to": "operativa"},
        {
          "condition": {"field": "fill_pct", "threshold": 5, "type": "value_lt"},
          "priority": 70,
          "to": "sin_stock"
        },
        {
          "condition": {"trigger": "custom_driver", "type": "trigger_type"},
          "priority": 80,
          "to": "fuera_de_servicio"
        }
      ]
    },
    {
      "color": "#ef4444",
      "label": "Sin stock",
      "name": "sin_stock",
      "transitions": [{"condition": {"trigger": "qr_scan", "type": "trigger_type"}, "priority": 50, "to": "operativa"}]
    },
    {
      "color": "#dc2626",
      "label": "Alarma temperatura",
      "name": "alarma_temperatura",
      "transitions": [
        {
          "condition": {"field": "temp_interior_c", "threshold": 6, "type": "value_lt"},
          "priority": 50,
          "to": "operativa"
        },
        {
          "condition": {"trigger": "custom_driver", "type": "trigger_type"},
          "priority": 80,
          "to": "fuera_de_servicio"
        }
      ]
    },
    {
      "color": "#6b7280",
      "label": "Fuera de servicio",
      "name": "fuera_de_servicio",
      "transitions": [
        {
          "condition": {"trigger": "custom_driver", "type": "trigger_type"},
          "priority": 50,
          "to": "en_reparacion"
        }
      ]
    },
    {
      "color": "#3b82f6",
      "label": "En reparación",
      "name": "en_reparacion",
      "transitions": [{"condition": {"trigger": "custom_driver", "type": "trigger_type"}, "priority": 50, "to": "operativa"}]
    }
  ]
  }}
{"kind": "entity", "entity": "fsm_machines", "id": 2, "data": {
  "description": "Ciclo de vida largo de una máquina expendedora",
  "name": "Ciclo de Vida — Máquina",
  "states": [
    {
      "color": "#10b981",
      "is_initial": true,
      "label": "En servicio",
      "name": "en_servicio",
      "transitions": [
        {
          "condition": {"trigger": "custom_driver", "type": "trigger_type"},
          "priority": 50,
          "to": "mantenimiento_mayor"
        },
        {"condition": {"trigger": "api_call", "type": "trigger_type"}, "priority": 30, "to": "retirada"}
      ]
    },
    {
      "color": "#f59e0b",
      "label": "Mantenimiento mayor",
      "name": "mantenimiento_mayor",
      "transitions": [
        {
          "condition": {"trigger": "custom_driver", "type": "trigger_type"},
          "priority": 50,
          "to": "en_servicio"
        },
        {"condition": {"trigger": "api_call", "type": "trigger_type"}, "priority": 30, "to": "retirada"}
      ]
    },
    {
      "color": "#6b7280",
      "is_final": true,
      "label": "Retirada / dada de baja",
      "name": "retirada",
      "transitions": []
    }
  ]
  }}

# asset_types: 7
{"kind": "entity", "entity": "asset_types", "id": 1, "data": {
  "color": "#92400e",
  "connectivity_tiers": ["qr", "gateway"],
  "description": "Máquinas expendedoras de bebidas calientes: café, té, chocolate. Grano, soluble o cápsula. Azkoyen, Necta, Bianchi, Saeco.",
  "fsm_id": 1,
