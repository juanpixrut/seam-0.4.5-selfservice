# Seam AMS demonstration data: the Issues module, over the seed 06-asahikenki.
# A .seed file, format version 2 (docs/SEED_FORMAT.md). It is an addition: load the seed it requires first, then:
#   python3 seeds/seed.py load issues-06-asahikenki --url http://localhost:9090
# xolu must run with XOLU_API_V2_ENABLED=true: the lifecycle of an issue is a state machine (/api/v2/fsm).
# Seam must run with the Issues module on (SEAM_ENABLE_ISSUES=1), as with any module that is off by default.
# Times written as {"$now": "-120m"} are relative to the moment of the load.
{"seed": 2,
  "name": "issues-06-asahikenki",
  "description": "朝日建機のインシデント：報告、テンプレート、QRコード、グループ化された案件",
  "tags": ["issues", "construction", "jp", "ja"],
  "version": "1",
  "addition": true,
  "requires": ["06-asahikenki"],
  "entities": ["issue_templates", "issue_template_assignments", "issue_qr_codes", "issues"],
  "notes": "12 issues in every state of the lifecycle (one case with two grouped issues), 2 templates (one with two versions) assigned to 2 asset types, 4 QR codes (one revoked). Seam must run with the module on (SEAM_ENABLE_ISSUES=1).",
  "x": {"seam": {"module": "issues"}}
  }

# The lifecycle of an issue: the state machine the application itself makes on first use, found here by name.
{"kind": "fsm_def", "match": ["name"], "as": "lifecycle", "body": {
  "name": "seam_issue_lifecycle",
  "description": "Seam AMS Issues lifecycle (8 states, iteration 1)",
  "initial": "reported",
  "determinism": "firstmatch",
  "states": {
    "reported": {"terminal": false},
    "triaged": {"terminal": false},
    "in_progress": {"terminal": false},
    "on_hold": {"terminal": false},
    "resolved": {"terminal": false},
    "closed": {"terminal": true},
    "rejected": {"terminal": true},
    "duplicate": {"terminal": true}
  },
  "transitions": [
    {"from": "reported", "input": "triage", "to": "triaged"},
    {"from": ["reported", "triaged"], "input": "start", "to": "in_progress"},
    {"from": ["triaged", "in_progress"], "input": "hold", "to": "on_hold"},
    {"from": "on_hold", "input": "resume", "to": "in_progress"},
    {"from": "in_progress", "input": "resolve", "to": "resolved"},
    {"from": "resolved", "input": "close", "to": "closed"},
    {
      "from": ["reported", "triaged", "in_progress", "on_hold", "resolved"],
      "input": "reject",
      "to": "rejected"
    },
    {"from": ["reported", "triaged", "in_progress"], "input": "merge", "to": "duplicate"}
  ]
  }}

