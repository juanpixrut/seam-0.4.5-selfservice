# Issue templates: the extra fields an issue asks for, by asset type. The second one has two versions; the current one is version 2.
{"kind": "entity", "entity": "issue_templates", "match": ["key", "version"], "as": "tpl_t1", "data": {
  "key": "heavy_machinery_failure",
  "name": "重機の故障",
  "description": "ショベルカーやブルドーザーの故障を報告するときに入力する項目。",
  "version": 1,
  "fields": [
    {"key": "hour_meter", "label": "アワーメーター (h)", "type": "number", "required": true},
    {"key": "error_code", "label": "モニターのエラーコード", "type": "text", "required": false},
    {"key": "machine_stopped", "label": "機械は停止していますか？", "type": "boolean", "required": false}
  ],
  "is_current": 1,
  "deleted": 0,
  "created_at": {"$now": "-30d"},
  "sla_config": {
    "first_response": {"critical": 30, "high": 60, "medium": 240, "low": 480},
    "resolution": {"critical": 240, "high": 480, "medium": 1440, "low": 2880}
  }
  }}
{"kind": "entity", "entity": "issue_templates", "match": ["key", "version"], "as": "tpl_t2_v1", "data": {
  "key": "generator_failure",
  "name": "発電機の故障",
  "description": "発電機の故障を報告するときに入力する項目。",
  "version": 1,
  "fields": [{"key": "running_hours", "label": "運転時間", "type": "number", "required": true}],
  "is_current": 0,
  "deleted": 0,
  "created_at": {"$now": "-30d"}
  }}
{"kind": "entity", "entity": "issue_templates", "match": ["key", "version"], "as": "tpl_t2", "data": {
  "key": "generator_failure",
  "name": "発電機の故障",
  "description": "発電機の故障を報告するときに入力する項目。",
  "version": 2,
  "fields": [
    {"key": "running_hours", "label": "運転時間", "type": "number", "required": true},
    {"key": "fuel_level", "label": "燃料残量 (%)", "type": "number", "required": false},
    {"key": "started", "label": "始動しましたか？", "type": "boolean", "required": false}
  ],
  "is_current": 1,
  "deleted": 0,
  "created_at": {"$now": "-12d"}
  }}
{"kind": "entity", "entity": "issue_template_assignments", "match": ["asset_type_id"], "data": {
  "asset_type_id": {"$seed": "type_t1"},
  "template_key": "heavy_machinery_failure",
  "updated_at": {"$now": "-12d"}
  }}
{"kind": "entity", "entity": "issue_template_assignments", "match": ["asset_type_id"], "data": {
  "asset_type_id": {"$seed": "type_t2"},
  "template_key": "generator_failure",
  "updated_at": {"$now": "-12d"}
  }}

