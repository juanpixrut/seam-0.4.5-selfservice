# One state machine per issue, and the inputs that took it to where it is. The history of each issue shows these
# steps with the time of the load, which is when they are made.
{"kind": "fsm_machine", "as": "m_iss_01", "phase": 36, "body": {"definition": {"$seed": "lifecycle"}}}
{"kind": "fsm_machine", "as": "m_iss_02", "phase": 36, "body": {"definition": {"$seed": "lifecycle"}}}
{"kind": "fsm_machine", "as": "m_iss_03", "phase": 36, "body": {"definition": {"$seed": "lifecycle"}}}
{"kind": "fsm_walk", "phase": 37, "machine": {"$seed": "m_iss_03"}, "input": "triage", "payload": {"actor": {"$seed": "u_manager"}}}
{"kind": "fsm_machine", "as": "m_iss_04", "phase": 36, "body": {"definition": {"$seed": "lifecycle"}}}
{"kind": "fsm_walk", "phase": 37, "machine": {"$seed": "m_iss_04"}, "input": "triage", "payload": {"actor": {"$seed": "u_manager"}}}
{"kind": "fsm_walk", "phase": 37, "machine": {"$seed": "m_iss_04"}, "input": "start", "payload": {"actor": {"$seed": "u_op1"}}}
{"kind": "fsm_machine", "as": "m_iss_05", "phase": 36, "body": {"definition": {"$seed": "lifecycle"}}}
{"kind": "fsm_walk", "phase": 37, "machine": {"$seed": "m_iss_05"}, "input": "triage", "payload": {"actor": {"$seed": "u_manager"}}}
