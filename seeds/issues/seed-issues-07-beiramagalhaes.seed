# Issue templates: the extra fields an issue asks for, by asset type. The second one has two versions; the current one is version 2.
{"kind": "entity", "entity": "issue_templates", "match": ["key", "version"], "as": "tpl_t1", "data": {
  "key": "falha_climatizacao",
  "name": "Falha de climatização",
  "description": "O que se pergunta quando é relatada uma falha em um chiller ou em uma central VRF.",
  "version": 1,
  "fields": [
    {"key": "horas_operacao", "label": "Horas de operação", "type": "number", "required": true},
    {"key": "codigo_alarme", "label": "Código de alarme no painel", "type": "text", "required": false},
    {"key": "equipamento_parado", "label": "O equipamento está parado?", "type": "boolean", "required": false}
  ],
  "is_current": 1,
  "deleted": 0,
  "created_at": {"$now": "-30d"},
  "sla_config": {
    "first_response": {"critical": 30, "high": 60, "medium": 240, "low": 480},
    "resolution": {"critical": 240, "high": 480, "medium": 1440, "low": 2880}
  }
  }}
{"kind": "entity", "entity": "issue_templates", "match": ["key", "version"], "as": "tpl_t2_v1", "data": {
  "key": "falha_gerador",
  "name": "Falha de gerador",
  "description": "O que se pergunta quando é relatada uma falha em um grupo gerador.",
  "version": 1,
  "fields": [{"key": "horas_motor", "label": "Horas de motor", "type": "number", "required": true}],
  "is_current": 0,
  "deleted": 0,
  "created_at": {"$now": "-30d"}
  }}
{"kind": "entity", "entity": "issue_templates", "match": ["key", "version"], "as": "tpl_t2", "data": {
  "key": "falha_gerador",
  "name": "Falha de gerador",
  "description": "O que se pergunta quando é relatada uma falha em um grupo gerador.",
  "version": 2,
  "fields": [
    {"key": "horas_motor", "label": "Horas de motor", "type": "number", "required": true},
    {"key": "nivel_combustivel", "label": "Nível de combustível (%)", "type": "number", "required": false},
    {"key": "deu_partida", "label": "Deu partida?", "type": "boolean", "required": false}
  ],
  "is_current": 1,
  "deleted": 0,
  "created_at": {"$now": "-12d"}
  }}
{"kind": "entity", "entity": "issue_template_assignments", "match": ["asset_type_id"], "data": {
  "asset_type_id": {"$seed": "type_t1"},
  "template_key": "falha_climatizacao",
  "updated_at": {"$now": "-12d"}
  }}
{"kind": "entity", "entity": "issue_template_assignments", "match": ["asset_type_id"], "data": {
  "asset_type_id": {"$seed": "type_t2"},
  "template_key": "falha_gerador",
  "updated_at": {"$now": "-12d"}
  }}

