# Issue templates: the extra fields an issue asks for, by asset type. The second one has two versions; the current one is version 2.
{"kind": "entity", "entity": "issue_templates", "match": ["key", "version"], "as": "tpl_t1", "data": {
  "key": "falla_de_camara_de_conservacion",
  "name": "Falla de cámara de conservación",
  "description": "Datos que se piden al reportar una falla en una cámara de conservación.",
  "version": 1,
  "fields": [
    {"key": "temperatura_leida", "label": "Temperatura leída (°C)", "type": "number", "required": true},
    {
      "key": "codigo_de_alarma",
      "label": "Código de alarma del controlador",
      "type": "text",
      "required": false
    },
    {"key": "hay_mercaderia", "label": "¿Hay mercadería adentro?", "type": "boolean", "required": false}
  ],
  "is_current": 1,
  "deleted": 0,
  "created_at": {"$now": "-30d"},
  "sla_config": {
    "first_response": {"critical": 30, "high": 60, "medium": 240, "low": 480},
    "resolution": {"critical": 240, "high": 480, "medium": 1440, "low": 2880}
  }
  }}
{"kind": "entity", "entity": "issue_templates", "match": ["key", "version"], "as": "tpl_t2_v1", "data": {
  "key": "desvio_de_frio_farmaceutico",
  "name": "Desvío de frío farmacéutico",
  "description": "Datos que se piden al reportar un desvío en un equipo de frío farmacéutico.",
  "version": 1,
  "fields": [{"key": "temperatura_leida", "label": "Temperatura leída (°C)", "type": "number", "required": true}],
  "is_current": 0,
  "deleted": 0,
  "created_at": {"$now": "-30d"}
  }}
{"kind": "entity", "entity": "issue_templates", "match": ["key", "version"], "as": "tpl_t2", "data": {
  "key": "desvio_de_frio_farmaceutico",
  "name": "Desvío de frío farmacéutico",
  "description": "Datos que se piden al reportar un desvío en un equipo de frío farmacéutico.",
  "version": 2,
  "fields": [
    {"key": "temperatura_leida", "label": "Temperatura leída (°C)", "type": "number", "required": true},
    {"key": "minutos_fuera_de_rango", "label": "Minutos fuera de rango", "type": "number", "required": false},
    {
      "key": "producto_en_cuarentena",
      "label": "¿Producto en cuarentena?",
      "type": "boolean",
      "required": false
    }
  ],
  "is_current": 1,
  "deleted": 0,
  "created_at": {"$now": "-12d"}
  }}
{"kind": "entity", "entity": "issue_template_assignments", "match": ["asset_type_id"], "data": {
  "asset_type_id": {"$seed": "type_t1"},
  "template_key": "falla_de_camara_de_conservacion",
  "updated_at": {"$now": "-12d"}
  }}
{"kind": "entity", "entity": "issue_template_assignments", "match": ["asset_type_id"], "data": {
  "asset_type_id": {"$seed": "type_t2"},
  "template_key": "desvio_de_frio_farmaceutico",
  "updated_at": {"$now": "-12d"}
  }}

