# Issue templates: the extra fields an issue asks for, by asset type. The second one has two versions; the current one is version 2.
{"kind": "entity", "entity": "issue_templates", "match": ["key", "version"], "as": "tpl_t1", "data": {
  "key": "averia_de_maquina_de_cafe",
  "name": "Avería de máquina de café",
  "description": "Datos que se piden al dar aviso de una avería en una máquina de café.",
  "version": 1,
  "fields": [
    {"key": "codigo_en_pantalla", "label": "Código en pantalla", "type": "text", "required": true},
    {"key": "devuelve_el_dinero", "label": "¿Devuelve el dinero?", "type": "boolean", "required": false},
    {"key": "producto_afectado", "label": "Producto afectado", "type": "text", "required": false}
  ],
  "is_current": 1,
  "deleted": 0,
  "created_at": {"$now": "-30d"},
  "sla_config": {
    "first_response": {"critical": 30, "high": 60, "medium": 240, "low": 480},
    "resolution": {"critical": 240, "high": 480, "medium": 1440, "low": 2880}
  }
  }}
{"kind": "entity", "entity": "issue_templates", "match": ["key", "version"], "as": "tpl_t2_v1", "data": {
  "key": "averia_de_maquina_de_bebidas_frias",
  "name": "Avería de máquina de bebidas frías",
  "description": "Datos que se piden al dar aviso de una avería en una máquina de bebidas frías.",
  "version": 1,
  "fields": [{"key": "temperatura_interior", "label": "Temperatura interior (°C)", "type": "number", "required": true}],
  "is_current": 0,
  "deleted": 0,
  "created_at": {"$now": "-30d"}
  }}
{"kind": "entity", "entity": "issue_templates", "match": ["key", "version"], "as": "tpl_t2", "data": {
  "key": "averia_de_maquina_de_bebidas_frias",
  "name": "Avería de máquina de bebidas frías",
  "description": "Datos que se piden al dar aviso de una avería en una máquina de bebidas frías.",
  "version": 2,
  "fields": [
    {"key": "temperatura_interior", "label": "Temperatura interior (°C)", "type": "number", "required": true},
    {"key": "carril_afectado", "label": "Carril afectado", "type": "text", "required": false},
    {"key": "producto_atascado", "label": "¿Producto atascado?", "type": "boolean", "required": false}
  ],
  "is_current": 1,
  "deleted": 0,
  "created_at": {"$now": "-12d"}
  }}
{"kind": "entity", "entity": "issue_template_assignments", "match": ["asset_type_id"], "data": {
  "asset_type_id": {"$seed": "type_t1"},
  "template_key": "averia_de_maquina_de_cafe",
  "updated_at": {"$now": "-12d"}
  }}
{"kind": "entity", "entity": "issue_template_assignments", "match": ["asset_type_id"], "data": {
  "asset_type_id": {"$seed": "type_t2"},
  "template_key": "averia_de_maquina_de_bebidas_frias",
  "updated_at": {"$now": "-12d"}
  }}

