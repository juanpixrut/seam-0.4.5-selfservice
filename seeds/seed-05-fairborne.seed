# fsm_machines: 2
{"kind": "entity", "entity": "fsm_machines", "id": 1, "data": {
  "description": "Operating states for light fleet vehicles",
  "name": "Vehicle Lifecycle",
  "states": [
    {
      "color": "#10b981",
      "is_initial": true,
      "label": "Available",
      "name": "available",
      "transitions": [
        {"condition": {"trigger": "qr_scan", "type": "trigger_type"}, "priority": 50, "to": "in_use"},
        {
          "condition": {"trigger": "custom_driver", "type": "trigger_type"},
          "priority": 80,
          "to": "in_service"
        }
      ]
    },
    {
      "color": "#3b82f6",
      "label": "In Use",
      "name": "in_use",
      "transitions": [
        {"condition": {"trigger": "qr_scan", "type": "trigger_type"}, "priority": 50, "to": "available"},
        {
          "condition": {"trigger": "custom_driver", "type": "trigger_type"},
          "priority": 80,
          "to": "in_service"
        }
      ]
    },
    {
      "color": "#f59e0b",
      "label": "In Service",
      "name": "in_service",
      "transitions": [
        {"condition": {"trigger": "custom_driver", "type": "trigger_type"}, "priority": 50, "to": "available"},
        {"condition": {"trigger": "api_call", "type": "trigger_type"}, "priority": 30, "to": "decommissioned"}
      ]
    },
    {
      "color": "#6b7280",
      "is_final": true,
      "label": "Decommissioned",
      "name": "decommissioned",
      "transitions": []
    }
  ]
  }}
{"kind": "entity", "entity": "fsm_machines", "id": 2, "data": {
  "description": "Operating states for heavy and agricultural machinery",
  "name": "Heavy Equipment Lifecycle",
  "states": [
    {
      "color": "#10b981",
      "is_initial": true,
      "label": "Operational",
      "name": "operational",
      "transitions": [
        {
          "condition": {"duration": "250h", "type": "duration_exceeded"},
          "priority": 60,
          "to": "scheduled_maintenance"
        },
        {"condition": {"trigger": "custom_driver", "type": "trigger_type"}, "priority": 80, "to": "in_repair"}
      ]
    },
    {
      "color": "#f59e0b",
      "label": "Scheduled Maintenance",
      "name": "scheduled_maintenance",
      "transitions": [
        {
          "condition": {"trigger": "custom_driver", "type": "trigger_type"},
          "priority": 50,
          "to": "operational"
        }
      ]
    },
    {
      "color": "#ef4444",
      "label": "In Repair",
      "name": "in_repair",
      "transitions": [
        {
          "condition": {"trigger": "custom_driver", "type": "trigger_type"},
          "priority": 50,
          "to": "operational"
        },
        {"condition": {"trigger": "api_call", "type": "trigger_type"}, "priority": 30, "to": "out_of_service"}
      ]
    },
    {
      "color": "#6b7280",
      "is_final": true,
      "label": "Out of Service",
      "name": "out_of_service",
      "transitions": []
    }
  ]
  }}

