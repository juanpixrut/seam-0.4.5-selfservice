# Seam AMS demonstration data: Fairborne Equipment LLC: seed 01 with its content in English
# A .seed file, format version 2 (docs/SEED_FORMAT.md). Load it with:
#   python3 seeds/seed.py load 05-fairborne --url http://localhost:9090
# Dates written as {"$date": "+90d"} and times as {"$now": "-2h"} are relative to the day of the load.
{"seed": 2,
  "name": "05-fairborne",
  "description": "Fairborne Equipment LLC: seed 01 with its content in English",
  "tags": ["construction", "us", "en"],
  "version": "1",
  "exclusive": true,
  "entities": [
    "regions",
    "currencies",
    "cost_centers",
    "brands",
    "models",
    "custodians",
    "alert_types",
    "prop_definitions",
    "locations",
    "asset_types",
    "assets",
    "prop_associations",
    "sensors",
    "users",
    "tenant_settings",
    "fsm_machines",
    "rules",
    "sensor_bindings",
    "alerts",
    "events"
  ],
  "notes": "Login:\n  admin@fairborne-equipment.example  / letsgetstarted\n  ops@fairborne-equipment.example    / letsgetstarted\n  dev@ual.li                         / holaquetal  (developer role)\n  manager@example.com / holaquetal  (manager)\n  viewer@example.com  / holaquetal  (viewer)",
  "x": {
    "seam": {
      "tenant_name": "Fairborne Equipment LLC",
      "logins": [
        {"email": "admin@fairborne-equipment.example", "password": "letsgetstarted", "role": "admin"},
        {"email": "ops@fairborne-equipment.example", "password": "letsgetstarted", "role": "admin"},
        {"email": "dev@ual.li", "password": "holaquetal", "role": "developer"},
        {"email": "manager@example.com", "password": "holaquetal", "role": "manager"},
        {"email": "viewer@example.com", "password": "holaquetal", "role": "viewer"}
      ]
    }
  }
  }

