#   python3 seeds/seed.py load 07-beiramagalhaes --url http://localhost:9090
# Dates written as {"$date": "+90d"} and times as {"$now": "-2h"} are relative to the day of the load.
{"seed": 2,
  "name": "07-beiramagalhaes",
  "description": "Beira Magalhães Hotéis e Resorts Ltda.: a hotel and resort group in Bahia, with its content in Portuguese",
  "tags": ["hospitality", "br", "pt"],
