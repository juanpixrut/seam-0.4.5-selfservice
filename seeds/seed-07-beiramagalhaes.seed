# fsm_machines: 2
{"kind": "entity", "entity": "fsm_machines", "id": 1, "data": {
  "description": "Estados de operação das vans de transfer e veículos de apoio",
  "name": "Ciclo de Vida de Veículos",
  "states": [
    {
      "color": "#10b981",
      "is_initial": true,
      "label": "Disponível",
      "name": "disponivel",
      "transitions": [
        {"condition": {"trigger": "qr_scan", "type": "trigger_type"}, "priority": 50, "to": "em_uso"},
        {
          "condition": {"trigger": "custom_driver", "type": "trigger_type"},
          "priority": 80,
          "to": "em_revisao"
        }
      ]
    },
    {
      "color": "#3b82f6",
      "label": "Em Uso",
      "name": "em_uso",
      "transitions": [
        {"condition": {"trigger": "qr_scan", "type": "trigger_type"}, "priority": 50, "to": "disponivel"},
        {
          "condition": {"trigger": "custom_driver", "type": "trigger_type"},
          "priority": 80,
          "to": "em_revisao"
        }
      ]
    },
    {
      "color": "#f59e0b",
      "label": "Em Revisão",
      "name": "em_revisao",
      "transitions": [
        {
          "condition": {"trigger": "custom_driver", "type": "trigger_type"},
          "priority": 50,
          "to": "disponivel"
        },
        {"condition": {"trigger": "api_call", "type": "trigger_type"}, "priority": 30, "to": "baixado"}
      ]
    },
    {"color": "#6b7280", "is_final": true, "label": "Baixado", "name": "baixado", "transitions": []}
  ]
  }}
{"kind": "entity", "entity": "fsm_machines", "id": 2, "data": {
  "description": "Estados de operação dos equipamentos prediais (climatização e elevadores)",
  "name": "Ciclo de Vida de Equipamentos Prediais",
  "states": [
    {
      "color": "#10b981",
      "is_initial": true,
      "label": "Operacional",
      "name": "operacional",
      "transitions": [
        {
          "condition": {"duration": "500h", "type": "duration_exceeded"},
          "priority": 60,
          "to": "manutencao_programada"
        },
        {"condition": {"trigger": "custom_driver", "type": "trigger_type"}, "priority": 80, "to": "em_reparo"}
      ]
    },
    {
      "color": "#f59e0b",
      "label": "Manutenção Programada",
      "name": "manutencao_programada",
      "transitions": [
        {
          "condition": {"trigger": "custom_driver", "type": "trigger_type"},
          "priority": 50,
          "to": "operacional"
        }
      ]
    },
    {
      "color": "#ef4444",
      "label": "Em Reparo",
      "name": "em_reparo",
      "transitions": [
        {
          "condition": {"trigger": "custom_driver", "type": "trigger_type"},
          "priority": 50,
          "to": "operacional"
        },
        {
          "condition": {"trigger": "api_call", "type": "trigger_type"},
          "priority": 30,
          "to": "fora_de_servico"
        }
      ]
    },
    {
      "color": "#6b7280",
      "is_final": true,
      "label": "Fora de Serviço",
      "name": "fora_de_servico",
      "transitions": []
    }
  ]
  }}

