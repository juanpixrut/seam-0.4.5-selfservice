    "sensor_bindings",
    "alerts",
    "events"
  ],
  "notes": "Login:\n  admin@beiramagalhaes.example  / letsgetstarted\n  ops@beiramagalhaes.example    / letsgetstarted\n  dev@ual.li                    / holaquetal  (developer role)\n  manager@example.com / holaquetal  (manager)\n  viewer@example.com  / holaquetal  (viewer)",
  "x": {
    "seam": {
      "tenant_name": "Beira Magalhães Hotéis e Resorts Ltda.",
      "logins": [
        {"email": "admin@beiramagalhaes.example", "password": "letsgetstarted", "role": "admin"},
