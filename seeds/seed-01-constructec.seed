# fsm_machines: 2
{"kind": "entity", "entity": "fsm_machines", "id": 1, "data": {
  "description": "Estados operativos de vehículos livianos de flota",
  "name": "Ciclo de Vida — Vehículo",
  "states": [
    {
      "color": "#10b981",
      "is_initial": true,
      "label": "Disponible",
      "name": "disponible",
      "transitions": [
        {"condition": {"trigger": "qr_scan", "type": "trigger_type"}, "priority": 50, "to": "en_uso"},
        {
          "condition": {"trigger": "custom_driver", "type": "trigger_type"},
          "priority": 80,
          "to": "en_servicio"
        }
      ]
    },
    {
      "color": "#3b82f6",
      "label": "En uso",
      "name": "en_uso",
      "transitions": [
        {"condition": {"trigger": "qr_scan", "type": "trigger_type"}, "priority": 50, "to": "disponible"},
        {
          "condition": {"trigger": "custom_driver", "type": "trigger_type"},
          "priority": 80,
          "to": "en_servicio"
        }
      ]
    },
    {
      "color": "#f59e0b",
      "label": "En servicio",
      "name": "en_servicio",
      "transitions": [
        {
          "condition": {"trigger": "custom_driver", "type": "trigger_type"},
          "priority": 50,
          "to": "disponible"
        },
        {"condition": {"trigger": "api_call", "type": "trigger_type"}, "priority": 30, "to": "dado_de_baja"}
      ]
    },
    {"color": "#6b7280", "is_final": true, "label": "Dado de baja", "name": "dado_de_baja", "transitions": []}
  ]
  }}
{"kind": "entity", "entity": "fsm_machines", "id": 2, "data": {
  "description": "Estados operativos de maquinaria pesada y agrícola",
  "name": "Ciclo de Vida — Maquinaria Pesada",
  "states": [
    {
      "color": "#10b981",
      "is_initial": true,
      "label": "Operativo",
      "name": "operativo",
      "transitions": [
        {
          "condition": {"duration": "250h", "type": "duration_exceeded"},
          "priority": 60,
          "to": "mantenimiento_prog"
        },
        {
          "condition": {"trigger": "custom_driver", "type": "trigger_type"},
          "priority": 80,
          "to": "en_reparacion"
        }
      ]
    },
    {
      "color": "#f59e0b",
      "label": "Mantenimiento programado",
      "name": "mantenimiento_prog",
      "transitions": [{"condition": {"trigger": "custom_driver", "type": "trigger_type"}, "priority": 50, "to": "operativo"}]
    },
    {
      "color": "#ef4444",
      "label": "En reparación",
      "name": "en_reparacion",
      "transitions": [
        {"condition": {"trigger": "custom_driver", "type": "trigger_type"}, "priority": 50, "to": "operativo"},
        {
          "condition": {"trigger": "api_call", "type": "trigger_type"},
          "priority": 30,
          "to": "fuera_de_servicio"
        }
      ]
    },
    {
      "color": "#6b7280",
      "is_final": true,
      "label": "Fuera de servicio",
      "name": "fuera_de_servicio",
      "transitions": []
    }
  ]
  }}

