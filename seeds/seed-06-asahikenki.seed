# Seam AMS demonstration data: Asahi Kenki K.K.: seed 01 with its content in Japanese
# A .seed file, format version 2 (docs/SEED_FORMAT.md). Load it with:
#   python3 seeds/seed.py load 06-asahikenki --url http://localhost:9090
# Dates written as {"$date": "+90d"} and times as {"$now": "-2h"} are relative to the day of the load.
{"seed": 2,
  "name": "06-asahikenki",
  "description": "Asahi Kenki K.K.: seed 01 with its content in Japanese",
  "tags": ["construction", "jp", "ja"],
  "version": "1",
  "exclusive": true,
  "entities": [
    "regions",
    "currencies",
    "cost_centers",
    "brands",
    "models",
    "custodians",
    "alert_types",
    "prop_definitions",
    "locations",
    "asset_types",
    "assets",
    "prop_associations",
    "sensors",
    "users",
    "tenant_settings",
    "fsm_machines",
    "rules",
    "sensor_bindings",
    "alerts",
    "events"
  ],
  "notes": "Login:\n  admin@asahi-kenki.example  / hajimemashou\n  ops@asahi-kenki.example    / hajimemashou\n  dev@ual.li                 / holaquetal  (developer role)\n  manager@example.com / holaquetal  (manager)\n  viewer@example.com  / holaquetal  (viewer)",
  "x": {
    "seam": {
      "tenant_name": "朝日建機株式会社",
      "logins": [
        {"email": "admin@asahi-kenki.example", "password": "hajimemashou", "role": "admin"},
        {"email": "ops@asahi-kenki.example", "password": "hajimemashou", "role": "admin"},
        {"email": "dev@ual.li", "password": "holaquetal", "role": "developer"},
        {"email": "manager@example.com", "password": "holaquetal", "role": "manager"},
        {"email": "viewer@example.com", "password": "holaquetal", "role": "viewer"}
      ]
    }
  }
  }

