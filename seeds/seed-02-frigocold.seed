# Seam AMS demonstration data: FrigoCold S.A.: cadena de frío comercial e industrial (Uruguay)
# A .seed file, format version 2 (docs/SEED_FORMAT.md). Load it with:
#   python3 seeds/seed.py load 02-frigocold --url http://localhost:9090
# Dates written as {"$date": "+90d"} and times as {"$now": "-2h"} are relative to the day of the load.
{"seed": 2,
  "name": "02-frigocold",
  "description": "FrigoCold S.A.: cadena de frío comercial e industrial (Uruguay)",
  "tags": ["cold-chain", "uy", "es"],
  "version": "1",
  "exclusive": true,
  "entities": [
    "regions",
    "currencies",
    "cost_centers",
    "brands",
    "models",
    "custodians",
    "alert_types",
    "prop_definitions",
    "locations",
    "fsm_machines",
    "asset_types",
    "assets",
    "prop_associations",
    "sensors",
    "users",
    "tenant_settings",
    "rules",
    "sensor_bindings",
    "alerts",
    "events"
  ],
  "notes": "Login:\n  hl@example.com  / holaquetal\n  dev@ual.li      / holaquetal  (rol developer)\n  manager@example.com / holaquetal  (manager)\n  viewer@example.com  / holaquetal  (viewer)\n  (equipo de desarrollo: 12 usuarios, rol operator)  / holaquetal",
  "x": {
    "seam": {
      "tenant_name": "FrigoCold Uruguay S.A.",
      "logins": [
        {"email": "hl@example.com", "password": "holaquetal", "role": "admin"},
        {"email": "dev@ual.li", "password": "holaquetal", "role": "developer"},
        {"email": "manager@example.com", "password": "holaquetal", "role": "manager"},
        {"email": "viewer@example.com", "password": "holaquetal", "role": "viewer"}
      ]
    }
  }
  }

