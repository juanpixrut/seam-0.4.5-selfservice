# fsm_machines: 2
{"kind": "entity", "entity": "fsm_machines", "id": 1, "data": {
  "description": "Estados operativos de cámaras de conservación y congelación",
  "name": "Estado Cámara Frigorífica",
  "states": [
    {
      "color": "#10b981",
      "is_initial": true,
      "label": "Normal",
      "name": "normal",
      "transitions": [
        {
          "condition": {"field": "temp_interior_c", "threshold": 6, "type": "value_gt"},
          "priority": 90,
          "to": "alarma_temperatura"
        },
        {
          "condition": {"trigger": "custom_driver", "type": "trigger_type"},
          "priority": 70,
          "to": "mantenimiento"
        },
        {"condition": {"trigger": "api_call", "type": "trigger_type"}, "priority": 30, "to": "inactiva"}
      ]
    },
    {
      "color": "#ef4444",
      "label": "Alarma temperatura",
      "name": "alarma_temperatura",
      "transitions": [
        {
          "condition": {"field": "temp_interior_c", "threshold": 5, "type": "value_lt"},
          "priority": 90,
          "to": "normal"
        },
        {
          "condition": {"trigger": "custom_driver", "type": "trigger_type"},
          "priority": 70,
          "to": "mantenimiento"
        }
      ]
    },
    {
      "color": "#f59e0b",
      "label": "Mantenimiento",
      "name": "mantenimiento",
      "transitions": [{"condition": {"trigger": "custom_driver", "type": "trigger_type"}, "priority": 50, "to": "normal"}]
    },
    {"color": "#6b7280", "is_final": true, "label": "Inactiva / baja", "name": "inactiva", "transitions": []}
  ]
  }}
{"kind": "entity", "entity": "fsm_machines", "id": 2, "data": {
  "description": "Estados de unidades de transporte con cadena de frío",
  "name": "Estado Transporte Refrigerado",
  "states": [
    {
      "color": "#6b7280",
      "is_initial": true,
      "label": "En depósito",
      "name": "en_deposito",
      "transitions": [
        {
          "condition": {"trigger": "gateway_poll", "type": "trigger_type"},
          "priority": 50,
          "to": "en_trayecto"
        }
      ]
    },
    {
      "color": "#3b82f6",
      "label": "En trayecto",
      "name": "en_trayecto",
      "transitions": [
        {"condition": {"trigger": "api_call", "type": "trigger_type"}, "priority": 50, "to": "en_deposito"},
        {"condition": {"trigger": "qr_scan", "type": "trigger_type"}, "priority": 70, "to": "en_entrega"},
        {
          "condition": {"field": "temp_caja_c", "threshold": 10, "type": "value_gt"},
          "priority": 90,
          "to": "alarma_temp_transito"
        }
      ]
    },
    {
      "color": "#10b981",
      "label": "En punto de entrega",
      "name": "en_entrega",
      "transitions": [
        {
          "condition": {"trigger": "gateway_poll", "type": "trigger_type"},
          "priority": 50,
          "to": "en_trayecto"
        },
        {"condition": {"trigger": "api_call", "type": "trigger_type"}, "priority": 70, "to": "en_deposito"}
      ]
    },
    {
      "color": "#ef4444",
      "label": "Alarma temp. en tránsito",
      "name": "alarma_temp_transito",
      "transitions": [
        {
          "condition": {"field": "temp_caja_c", "threshold": 8, "type": "value_lt"},
          "priority": 90,
          "to": "en_trayecto"
        }
      ]
    },
    {"color": "#1f2937", "is_final": true, "label": "Dado de baja", "name": "dado_de_baja", "transitions": []}
  ]
  }}

