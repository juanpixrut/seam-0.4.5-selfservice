// AdminUsersList handles GET /admin/users
func (h *UIHandler) AdminUsersList(w http.ResponseWriter, r *http.Request) {
	ctx := r.Context()
	roleFilter := r.URL.Query().Get("role")

	// Build OQL query (uses TOP n, not LIMIT)
	query := "SELECT TOP 100 * FROM users ORDER BY name ASC"
	if roleFilter != "" {
		query = "SELECT TOP 100 * FROM users WHERE role = '" + roleFilter + "' ORDER BY name ASC"
	}

	result, err := h.xoluClient.OQL(ctx, query)
	if err != nil {
		h.logger.Error("failed to list users", "error", err)
	}

	users := make([]UserRow, 0)
	if result != nil {
		for _, row := range result.Data {
			users = append(users, UserRow{
				ID:          toInt64(row["id"]),
				Email:       toString(row["email"]),
				Name:        toString(row["name"]),
				Role:        toString(row["role"]),
				Active:      toBool(row["active"]),
				LastLoginAt: formatTimeAgo(toString(row["last_login_at"])),
				CreatedAt:   toString(row["created_at"]),
			})
		}
	}

	// Check permissions for current user
	currentUser := h.getCurrentUser(r)
	canCreate := auth.HasPermission(currentUser.Role, auth.PermUserCreate)
	canEdit := auth.HasPermission(currentUser.Role, auth.PermUserUpdate)
	canDelete := auth.HasPermission(currentUser.Role, auth.PermUserDelete)

	data := UsersListData{
		Users:      users,
		Total:      len(users),
		RoleFilter: roleFilter,
		CanCreate:  canCreate,
		CanEdit:    canEdit,
		CanDelete:  canDelete,
	}

	h.page.Render(w, r, "Users", "/admin/users", UsersListPage(data))
}

