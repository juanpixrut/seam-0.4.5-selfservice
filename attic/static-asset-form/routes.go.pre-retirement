	// Path: /asset-types/{id}/edit — strip "/edit" suffix then extract id
	trimmed := r.URL.Path
	if len(trimmed) > 5 && trimmed[len(trimmed)-5:] == "/edit" {
		trimmed = trimmed[:len(trimmed)-5]
