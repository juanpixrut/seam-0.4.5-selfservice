func extractPathSegment(path, prefix string) string {
	if len(path) <= len(prefix) {
		return ""
	}
	rest := path[len(prefix):]
	// Find end (next / or end of string)
	end := 0
	for end < len(rest) && rest[end] != '/' {
		end++
	}
	return rest[:end]
}

func toFloat(v interface{}) float64 {
	switch n := v.(type) {
	case float64:
		return n
	case float32:
		return float64(n)
	case int:
		return float64(n)
	case int64:
		return float64(n)
	default:
		return 0
	}
}

