// AdminUserCreate handles POST /admin/users
func (h *UIHandler) AdminUserCreate(w http.ResponseWriter, r *http.Request) {
	ctx := r.Context()

	if err := r.ParseForm(); err != nil {
		http.Error(w, "Invalid form data", http.StatusBadRequest)
		return
	}

	email := r.FormValue("email")
	name := r.FormValue("name")
	role := r.FormValue("role")
	password := r.FormValue("password")
	passwordConfirm := r.FormValue("password_confirm")

	// Validate
	errors := make(map[string]string)
	if email == "" {
		errors["email"] = "Email is required"
	}
	if name == "" {
		errors["name"] = "Name is required"
	}
	if role == "" {
		errors["role"] = "Role is required"
	}
	if password == "" {
		errors["password"] = "Password is required"
	} else if len(password) < 8 {
		errors["password"] = "Password must be at least 8 characters"
	}
	if password != passwordConfirm {
		errors["password_confirm"] = "Passwords do not match"
	}

	if len(errors) > 0 {
		data := UserFormData{
			IsEdit: false,
			User: UserFormValues{
				Email:  email,
				Name:   name,
				Role:   role,
				Active: true,
			},
			AvailableRoles: []RoleOption{
				{Value: "admin", Label: "Administrator", Selected: role == "admin"},
				{Value: "manager", Label: "Manager", Selected: role == "manager"},
				{Value: "operator", Label: "Operator", Selected: role == "operator"},
				{Value: "viewer", Label: "Viewer", Selected: role == "viewer"},
			},
			Errors:    errors,
			CSRFToken: h.GetCSRFToken(w, r),
		}
		h.page.Render(w, r, "Add User", "/admin/users", UserFormPage(data))
		return
	}

	// Create user via UserService (handles password hashing)
	if h.userService != nil {
		// Get tenant ID from authenticated user's session - REQUIRED
		claims, ok := auth.ClaimsFromContext(ctx)
		if !ok || claims.TenantID == 0 {
			h.logger.Error("cannot create user without valid session with tenant")
			http.Error(w, "Authentication required", http.StatusUnauthorized)
			return
		}
		tenantID := claims.TenantID

		_, err := h.userService.CreateUser(ctx, auth.CreateUserInput{
			TenantID: tenantID,
			Email:    email,
			Name:     name,
			Password: password,
			Role:     role,
		})
		if err != nil {
			h.logger.Error("failed to create user", "error", err)
			if err == auth.ErrUserExists {
				errors["email"] = "A user with this email already exists"
				data := UserFormData{
					IsEdit: false,
					User: UserFormValues{
						Email:  email,
						Name:   name,
						Role:   role,
						Active: true,
					},
					AvailableRoles: []RoleOption{
						{Value: "admin", Label: "Administrator", Selected: role == "admin"},
						{Value: "manager", Label: "Manager", Selected: role == "manager"},
						{Value: "operator", Label: "Operator", Selected: role == "operator"},
						{Value: "viewer", Label: "Viewer", Selected: role == "viewer"},
					},
					Errors: errors,
				}
				h.page.Render(w, r, "Add User", "/admin/users", UserFormPage(data))
				return
			}
			http.Error(w, "Failed to create user", http.StatusInternalServerError)
			return
		}
	} else {
		// Fallback: Create directly in xolu (no password hashing)
		userData := map[string]interface{}{
			"email":      email,
			"name":       name,
			"role":       role,
			"active":     true,
			"created_at": time.Now().UTC().Format(time.RFC3339),
		}

		_, err := h.xoluClient.Create(ctx, "users", userData)
		if err != nil {
			h.logger.Error("failed to create user", "error", err)
			http.Error(w, "Failed to create user", http.StatusInternalServerError)
			return
		}
	}

	http.Redirect(w, r, "/admin/users", http.StatusSeeOther)
}

