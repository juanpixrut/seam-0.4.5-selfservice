	// Map keys are AssetCreateSchema's English field names (T-24). The
	// HTML form field names read via r.FormValue are unchanged (still the
	// original Spanish names) -- only the Go-level map key changes here.
	// AssetEnumValueFromXoluValue translates the three enum fields'
	// Spanish values to English so they validate against the now-English
	// schema. AssetValuesToXolu (called below, after validation) converts
	// this whole map back to xolu's Spanish-keyed/valued storage shape,
	// so persisted behaviour is unchanged.
	assetData := map[string]any{
