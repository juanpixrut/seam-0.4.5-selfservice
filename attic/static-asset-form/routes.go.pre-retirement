		}
		return
	}

	// Collect dynamic field values from form
	identityFields, stateFields := collectDynamicFieldValues(r)

	// Collect custom property values (P-19) — form: prop_values[nombre_corto]
	propValues := map[string]interface{}{}
	for key, vals := range r.Form {
		if len(vals) == 0 || len(key) <= 12 {
			continue
		}
		if key[:12] == "prop_values[" && key[len(key)-1] == ']' {
			nombreCorto := key[12 : len(key)-1]
			if vals[0] != "" {
