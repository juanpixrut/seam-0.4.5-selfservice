			Refrigerante:       toString(entity.Data["refrigerante"]),
			VoltajeConsumo:     toString(entity.Data["voltaje_consumo"]),
			PrecioCompra:       toString(entity.Data["precio_compra"]),
			MonedaID:           toInt64(entity.Data["moneda_id"]),
			PrecioActual:       toString(entity.Data["precio_actual"]),
			CentroCostoID:      toInt64(entity.Data["centro_costo_id"]),
			FinGarantia:        toString(entity.Data["fin_garantia"]),
		},
		Statuses:     []string{"active", "inactive", "maintenance", "lost"},
		Connectivity: []string{"qr_only", "gateway", "lora_mesh", "gps_cellular"},
		CSRFToken:    h.GetCSRFToken(w, r),
		Marcas:       h.loadMarcas(ctx),
		Modelos:      h.loadModelos(ctx),
		Regiones:     h.loadRegiones(ctx),
		Ubicaciones:  h.loadUbicaciones(ctx),
		Custodios:    h.loadCustodiosSimple(ctx),
		Monedas:      h.loadMonedasSimple(ctx),
		CentrosCosto: h.loadCentrosCosto(ctx),
		Alertas:      h.loadAlertas(ctx),
	}

	// Fetch asset types
	typesResult, _ := h.xoluClient.OQL(ctx, "SELECT id, name FROM asset_types ORDER BY name")
	if typesResult != nil {
		for _, row := range typesResult.Data {
			data.AssetTypes = append(data.AssetTypes, AssetTypeOption{
				ID:       toInt64(row["id"]),
				Name:     toString(row["name"]),
				Selected: toInt64(row["id"]) == data.Asset.TypeID,
			})
		}
	}

	// Load custom property values for this asset (P-19)
	propVals, _ := entity.Data["prop_values"].(map[string]interface{})
	if data.Asset.TypeID != 0 {
		data.PropValues = h.LoadPropValues(ctx, "asset_type", data.Asset.TypeID, propVals)
	}

	// Load dynamic fields from asset type template
	if data.Asset.TypeID != 0 {
		if at, err := h.xoluClient.Get(ctx, "asset_types", data.Asset.TypeID); err == nil {
			data.IdentityFields = extractFieldRows(at.Data["identity_template"])
			data.StateFields = extractFieldRows(at.Data["state_template"])
		}
	}

	// Populate existing field values from asset data
	data.FieldValues = make(map[string]string)
	if idFields, ok := entity.Data["identity_fields"].(map[string]any); ok {
		for k, v := range idFields {
			data.FieldValues["identity."+k] = fmt.Sprintf("%v", v)
		}
	}
	if stFields, ok := entity.Data["state_fields"].(map[string]any); ok {
		for k, v := range stFields {
			data.FieldValues["state."+k] = fmt.Sprintf("%v", v)
		}
	}

	if IsHTMXRequest(r) {
		data.IsPartial = true
		h.page.RenderPartial(w, AssetFormPage(data))
	} else {
		http.Redirect(w, r, fmt.Sprintf("/assets/%d", id), http.StatusSeeOther)
	}
}

// EventsList handles GET /events
func (h *UIHandler) EventsList(w http.ResponseWriter, r *http.Request) {
	ctx := r.Context()

	// Parse query params
	page := queryInt(r, "page", 1)
	pageSize := 50
	offset := (page - 1) * pageSize
	assetFilter := r.URL.Query().Get("asset_id")
	typeFilter := r.URL.Query().Get("type")
	fromDate := r.URL.Query().Get("from")
	toDate := r.URL.Query().Get("to")

	// Build query (OQL uses TOP n, not LIMIT/OFFSET)
	fetchCount := pageSize + offset
	query := "SELECT TOP " + strconv.Itoa(fetchCount) + " e.*, a.name as asset_name FROM events e JOIN assets a ON e.asset_id = a.id"
	conditions := []string{}

	if assetFilter != "" {
		conditions = append(conditions, "e.asset_id = "+assetFilter)
	}
	if typeFilter != "" {
		conditions = append(conditions, "e.trigger_type = '"+typeFilter+"'")
	}
	if fromDate != "" {
		conditions = append(conditions, "e.timestamp >= '"+fromDate+"'")
	}
	if toDate != "" {
		conditions = append(conditions, "e.timestamp <= '"+toDate+"'")
	}

	if len(conditions) > 0 {
		query += " WHERE " + joinStrings(conditions, " AND ")
	}

	query += " ORDER BY e.timestamp DESC"

	data := EventsListData{
		Page:        page,
		PageSize:    pageSize,
		AssetFilter: assetFilter,
		TypeFilter:  typeFilter,
		FromDate:    fromDate,
		ToDate:      toDate,
		TriggerTypes: []string{
			"sensor_driver",
			"custom_driver",
			"qr_scan",
			"api_call",
			"mobile_app",
			"lora_notification",
			"gateway_poll",
		},
	}

	result, err := h.xoluClient.OQL(ctx, query)
	if err == nil {
		// Apply offset by slicing (OQL doesn't support OFFSET)
		rows := result.Data
		if offset > 0 && offset < len(rows) {
			rows = rows[offset:]
		} else if offset >= len(rows) {
			rows = []map[string]any{}
		}
		if len(rows) > pageSize {
			rows = rows[:pageSize]
		}
		for _, row := range rows {
			data.Events = append(data.Events, EventRow{
				ID:          toInt64(row["id"]),
				AssetID:     toInt64(row["asset_id"]),
				AssetName:   toString(row["asset_name"]),
				TriggerType: toString(row["trigger_type"]),
				Value:       toString(row["value"]),
				Timestamp:   toString(row["timestamp"]),
				Processed:   toBool(row["processed"]),
			})
		}
	}

	// Get total count
	countResult, err := h.xoluClient.OQL(ctx, "SELECT COUNT(*) as total FROM events")
	if err == nil && len(countResult.Data) > 0 {
		data.Total = toInt(countResult.Data[0]["total"])
	}

	// Render
	h.page.Render(w, r, "Events", "/events", EventsListPage(data))
}

// SensorsList handles GET /sensors
func (h *UIHandler) SensorsList(w http.ResponseWriter, r *http.Request) {
	ctx := r.Context()

	page := queryInt(r, "page", 1)
	pageSize := 20
	offset := (page - 1) * pageSize
	typeFilter := r.URL.Query().Get("type")
	statusFilter := r.URL.Query().Get("status")

	// OQL uses TOP n, not LIMIT/OFFSET
	fetchCount := pageSize + offset
	query := "SELECT TOP " + strconv.Itoa(fetchCount) + " * FROM sensors"
	conditions := []string{}

	if typeFilter != "" {
		conditions = append(conditions, "type = '"+typeFilter+"'")
	}
	if statusFilter != "" {
		conditions = append(conditions, "status = '"+statusFilter+"'")
	}

	if len(conditions) > 0 {
		query += " WHERE " + joinStrings(conditions, " AND ")
	}
	query += " ORDER BY last_seen DESC"

	data := SensorsListData{
		Page:         page,
		PageSize:     pageSize,
		TypeFilter:   typeFilter,
		StatusFilter: statusFilter,
		SensorTypes:  []string{"rfid", "ble", "gps", "nfc", "barcode", "camera", "generic"},
	}

	result, err := h.xoluClient.OQL(ctx, query)
	if err == nil {
		// Apply offset by slicing (OQL doesn't support OFFSET)
		rows := result.Data
		if offset > 0 && offset < len(rows) {
			rows = rows[offset:]
		} else if offset >= len(rows) {
			rows = []map[string]any{}
		}
		if len(rows) > pageSize {
			rows = rows[:pageSize]
		}
		for _, row := range rows {
			data.Sensors = append(data.Sensors, SensorRow{
				ID:         toInt64(row["id"]),
				ExternalID: toString(row["external_id"]),
				Name:       toString(row["name"]),
				Type:       toString(row["type"]),
				Protocol:   toString(row["protocol"]),
				Status:     toString(row["status"]),
				LastSeen:   toString(row["last_seen"]),
			})
		}
	}

	countResult, err := h.xoluClient.OQL(ctx, "SELECT COUNT(*) as total FROM sensors")
	if err == nil && len(countResult.Data) > 0 {
		data.Total = toInt(countResult.Data[0]["total"])
	}

	h.page.Render(w, r, "Sensors", "/sensors", SensorsListPage(data))
}

