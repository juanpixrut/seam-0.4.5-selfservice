		"warranty_end":     r.FormValue("fin_garantia"),
		"links_documentos": parseDocumentLinksToAny(r, "links_documentos"),
	}
	if len(identityFields) > 0 {
		assetData["identity_fields"] = identityFields
	}
	if len(stateFields) > 0 {
		assetData["state_fields"] = stateFields
	}

	if postErrs := validateForm(assetData, schemaAssetCreate); postErrs != nil {
		typesResult, _ := h.xoluClient.OQL(ctx, "SELECT id, name FROM asset_types ORDER BY name")
		data := AssetFormData{
			IsEdit: false, Error: errorsToSummary(postErrs),
