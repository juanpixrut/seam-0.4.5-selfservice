	if preErrs := validateForm(preCheck, schemaAssetCreate); preErrs != nil {
		typesResult, _ := h.xoluClient.OQL(ctx, "SELECT id, name FROM asset_types ORDER BY name")
		data := AssetFormData{
			IsEdit:       false,
			Statuses:     []string{"active", "inactive", "maintenance", "lost"},
			Connectivity: []string{"qr_only", "gateway", "lora_mesh", "gps_cellular"},
