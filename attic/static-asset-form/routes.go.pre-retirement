				data.AssetTypes = append(data.AssetTypes, AssetTypeOption{ID: toInt64(row["id"]), Name: toString(row["name"])})
			}
		}
		if IsHTMXRequest(r) {
			data.IsPartial = true
			h.page.RenderPartial(w, AssetFormPage(data))
		} else {
			h.page.Render(w, r, "Crear Activo", "/assets", AssetFormPage(data))
		}
		return
	}
	assetData = AssetValuesToXolu(assetData)
	_, err := h.xoluClient.Create(ctx, "assets", assetData)
	if err != nil {
		h.logger.Error("failed to create asset", "error", err)
