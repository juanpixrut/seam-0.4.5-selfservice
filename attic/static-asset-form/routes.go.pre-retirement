// collectDynamicFieldValues extracts identity.* and state.* form values into maps.
func collectDynamicFieldValues(r *http.Request) (map[string]any, map[string]any) {
	identity := map[string]any{}
	state := map[string]any{}
	for key, vals := range r.Form {
		if len(vals) == 0 || vals[0] == "" {
			continue
		}
		if len(key) > 9 && key[:9] == "identity." {
			identity[key[9:]] = vals[0]
		} else if len(key) > 6 && key[:6] == "state." {
			state[key[6:]] = vals[0]
		}
	}
	return identity, state
}

