			b.Div(mi.ID("tab-finserv"), mi.Class("asset-tab-panel pt-4"),
				b.Div(mi.Class("grid grid-cols-1 lg:grid-cols-2 gap-6"),
					b.Div(mi.Class("space-y-4"),
						b.H3(mi.Class("text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider"), "Finanzas"),
