// AssetFormData holds data for the asset create/edit form.
type AssetFormData struct {
	IsEdit         bool
	IsPartial      bool   // true when rendered inside the SeamModal (HTMX partial)
	Error          string // top-level summary shown as a banner above the tabs
	Asset          AssetDetail
	AssetTypes     []AssetTypeOption
	Statuses       []string
	Connectivity   []string
	Errors         map[string]string
	CSRFToken      string
	IdentityFields []FieldRow
	StateFields    []FieldRow
	FieldValues    map[string]string

	// Wave 2 dropdown data
	Marcas       []MarcaRow
	Modelos      []ModeloRow
	Regiones     []RegionRow
	Ubicaciones  []UbicacionRow
	Custodios    []CustodioRow
	Monedas      []MonedaRow
	CentrosCosto []CentroCostoRow
	Alertas      []AlertaRow

	// Wave 2 — Block D custody
	LinksComodato []DocumentLink
	// Wave 2 — Block E lifecycle
	LinksCicloVida []DocumentLink
	// Wave 2 — Block G finance
	LinksDocumentos []DocumentLink
	// Wave 3 — P-19 custom property values
	PropValues []PropValueEntry
}

// ServiceConfig is one entry in the Block F repeating service config group.
type ServiceConfig struct {
	Medida   string
	Umbral   float64
	AlertaID int64
}

// AssetTypeOption represents an asset type option for the selector.
type AssetTypeOption struct {
	ID       int64
	Name     string
	Selected bool
}

// AssetFormPage renders the asset create/edit form.
func AssetFormPage(data AssetFormData) mi.H {
	return func(b *mi.Builder) mi.Node {
		action := "/assets"
		method := "post"
		if data.IsEdit {
			action = fmt.Sprintf("/assets/%d", data.Asset.ID)
		}

		// When rendered as a modal partial, the form uses hx-post so the
		// response can be swapped back into the modal body on validation error,
		// or trigger HX-Redirect on success — without a full page navigation.
		var formAttrs []interface{}
		formAttrs = append(formAttrs, mi.Class("space-y-0"))
		if data.IsPartial {
			formAttrs = append(formAttrs,
				mi.ID("asset-edit-form"),
				mi.Attr("hx-post", action),
				mi.Attr("hx-target", "#seam-modal-body"),
				mi.Attr("hx-swap", "innerHTML"),
			)
		} else {
			formAttrs = append(formAttrs, mi.Method(method), mi.Action(action))
		}

		// Error banner (top-level, shown above tabs).
		// data.Error is a pre-formatted summary; if absent, build one from the
		// Errors map so that every validation failure is visible regardless of
		// whether the individual field widget is wired to show it.
		var errorBanner mi.Node
		bannerText := data.Error
		if bannerText == "" && len(data.Errors) > 0 {
			bannerText = errorsToSummary(data.Errors)
		}
		if bannerText != "" {
			errorBanner = b.Div(mi.Class("mb-4 px-4 py-3 bg-red-50 dark:bg-red-900/20 border border-red-300 dark:border-red-700 rounded-lg text-sm text-red-700 dark:text-red-400 whitespace-pre-line"),
				bannerText,
			)
		} else {
			errorBanner = b.Span()
		}

		// Append all form children to attrs slice (Go doesn't allow f(slice..., moreArgs))
		formAttrs = append(formAttrs,
			CSRFField(data.CSRFToken)(b),
			conditionalMethodOverride(b, method),
			errorBanner,

			// ── Tab bar (3 tabs) ────────────────────────────────────
			b.Div(mi.Class("border-b border-gray-200 dark:border-gray-700"),
				b.Div(mi.Class("flex gap-0 overflow-x-auto"),
					assetTabBtn(b, "tab-principal", "Principal", true),
					assetTabBtn(b, "tab-loc", "Ubicación y Custodia", false),
					assetTabBtn(b, "tab-ciclo", "Ciclo de Vida", false),
					assetTabBtn(b, "tab-finserv", "Finanzas y Service", false),
				),
			),

			// ── Tab 1: Principal (Basic + Blocks A + B) ────────────
			b.Div(mi.ID("tab-principal"), mi.Class("asset-tab-panel pt-4"),
				b.Div(mi.Class("grid grid-cols-1 lg:grid-cols-2 gap-6"),
					// Left: core identity
					b.Div(mi.Class("space-y-4"),
						b.H3(mi.Class("text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider"), "Básico"),
						formFieldWithError(b, "Nombre *", "name", "text", data.Asset.Name, data.Errors["name"], true),
						assetTypeSelectWithHTMX(b, "Tipo de Activo *", "type_id", data.AssetTypes, data.Errors["type_id"]),
						b.Div(mi.Class("grid grid-cols-2 gap-3"),
							statusSelectErr(b, "Estado", "status", data.Statuses, data.Asset.Status, fieldError(data.Errors, "status")),
							assetEnumSelectErr(b, "Criticidad *", "criticidad", data.Asset.Criticidad, true,
								[]struct{ V, L string }{{"Alta", "Alta"}, {"Media", "Media"}, {"Baja", "Baja"}},
								fieldError(data.Errors, "criticidad")),
						),
						connectivitySelectErr(b, "Conectividad", "connectivity_tier", data.Connectivity, data.Asset.ConnectivityTier, fieldError(data.Errors, "connectivity_tier")),
					),
					// Right: identification + characterisation
					b.Div(mi.Class("space-y-4"),
						b.H3(mi.Class("text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider"), "Identificación"),
						b.Div(mi.Class("grid grid-cols-2 gap-3"),
							formFieldWithError(b, "GIAI", "giai", "text", data.Asset.GIAI, nil, false),
							formFieldWithError(b, "GRAI", "grai", "text", data.Asset.GRAI, nil, false),
						),
						formFieldWithError(b, "Código Barras / RFID", "codigo_barras_rfid", "text", data.Asset.CodigoBarrasRFID, nil, false),
						formFieldWithError(b, "Tag Técnico", "tag_tecnico", "text", data.Asset.TagTecnico, nil, false),
						b.H3(mi.Class("text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider pt-1"), "Caracterización"),
						b.Div(mi.Class("grid grid-cols-2 gap-3"),
							assetFKSelectWithJump(b, "Marca", "marca_id", data.Asset.MarcaID, "/marcas", func() []struct {
								ID    int64
								Label string
							} {
								var opts []struct {
									ID    int64
									Label string
								}
								for _, m := range data.Marcas {
									opts = append(opts, struct {
										ID    int64
										Label string
									}{m.ID, m.Codigo + " — " + m.Nombre})
								}
								return opts
							}()),
							assetFKSelectWithJump(b, "Modelo", "modelo_id", data.Asset.ModeloID, "/modelos", func() []struct {
								ID    int64
								Label string
							} {
								var opts []struct {
									ID    int64
									Label string
								}
								for _, m := range data.Modelos {
									opts = append(opts, struct {
										ID    int64
										Label string
									}{m.ID, m.Nombre})
								}
								return opts
							}()),
						),
						b.Div(mi.Class("grid grid-cols-2 gap-3"),
							formFieldWithError(b, "Serie 1", "serie_1", "text", data.Asset.Serie1, nil, false),
							formFieldWithError(b, "Serie 2", "serie_2", "text", data.Asset.Serie2, nil, false),
						),
						formFieldWithError(b, "Lote", "lote", "text", data.Asset.Lote, nil, false),
						// Dynamic fields from asset type template
						b.Div(mi.ID("asset-type-fields"),
							assetDynamicFields(b, data.IdentityFields, data.StateFields, data.FieldValues),
						),
					),
				),
			),

			// ── Tab 2: Ubicación y Custodia (Blocks C + D) ────────
			b.Div(mi.ID("tab-loc"), mi.Class("asset-tab-panel pt-4"),
				b.Div(mi.Class("grid grid-cols-1 lg:grid-cols-2 gap-6"),
					b.Div(mi.Class("space-y-4"),
						b.H3(mi.Class("text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider"), "Ubicación Física"),
						assetFKSelectWithJump(b, "Ubicación", "ubicacion_fisica_id", data.Asset.UbicacionFisicaID, "/ubicaciones", func() []struct {
							ID    int64
							Label string
						} {
							var opts []struct {
								ID    int64
								Label string
							}
							for _, u := range data.Ubicaciones {
								opts = append(opts, struct {
									ID    int64
									Label string
								}{u.ID, u.NombreCorto})
							}
							return opts
						}()),
						assetFKSelect(b, "Región *", "region_id", data.Asset.RegionID, func() []struct {
							ID    int64
							Label string
						} {
							var opts []struct {
								ID    int64
								Label string
							}
							for _, r := range data.Regiones {
								opts = append(opts, struct {
									ID    int64
									Label string
								}{r.ID, r.Descripcion})
							}
							return opts
						}()),
						b.Div(mi.Class("grid grid-cols-2 gap-3"),
							formFieldWithError(b, "Latitud", "latitude", "number", "", nil, false),
							formFieldWithError(b, "Longitud", "longitude", "number", "", nil, false),
						),
						formFieldWithError(b, "ID Padre", "id_padre", "number",
							func() string {
								if data.Asset.IDPadre == 0 {
									return ""
								}
								return fmt.Sprintf("%d", data.Asset.IDPadre)
							}(), nil, false),
					),
					b.Div(mi.Class("space-y-4"),
						b.H3(mi.Class("text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider"), "Custodia"),
						assetFKSelectWithJump(b, "Custodio", "custodio_id", data.Asset.CustodioID, "/custodios", func() []struct {
							ID    int64
							Label string
						} {
							var opts []struct {
								ID    int64
								Label string
							}
							for _, c := range data.Custodios {
								opts = append(opts, struct {
									ID    int64
									Label string
								}{c.ID, c.NombreRazonSocial})
							}
							return opts
						}()),
						assetEnumSelectErr(b, "Calidad de Tenencia", "calidad_tenencia", data.Asset.CalidadTenencia, false,
