							formFieldWithError(b, "Fecha Prev. Ingreso", "fecha_prev_ingreso", "date", data.Asset.FechaPrevIngreso, nil, false),
							formFieldWithError(b, "Fecha Ingreso", "fecha_ingreso", "date", data.Asset.FechaIngreso, nil, false),
							formFieldWithError(b, "Fecha Obsolescencia", "fecha_obsolescencia", "date", data.Asset.FechaObsolescencia, nil, false),
