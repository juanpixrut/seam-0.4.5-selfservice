	nodes = append(nodes, b.Option(mi.Value(""), "— select type —"))
	for _, opt := range options {
		if opt.Selected {
			nodes = append(nodes, b.Option(mi.Value(fmt.Sprintf("%d", opt.ID)), mi.Selected(), opt.Name))
		} else {
			nodes = append(nodes, b.Option(mi.Value(fmt.Sprintf("%d", opt.ID)), opt.Name))
		}
	}
	opts = append(opts, nodes...)
	selectedID := int64(0)
	for _, opt := range options {
		if opt.Selected {
			selectedID = opt.ID
			break
		}
	}
	jumpStyle := "display:none"
	if selectedID > 0 {
		jumpStyle = ""
	}
	labelNode := b.Label(mi.For(name),
		mi.Class("flex items-center text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"),
		b.Span(mi.Class("flex-1"), label, b.Span(mi.Class("text-red-500 ml-1"), "*")),
		b.Button(
			mi.ID("jump-"+name),
			mi.Type("button"),
			mi.Attr("onclick", "SeamPopover.show(this,'"+name+"')"),
			mi.Title("Ver / editar tipo de activo"),
			mi.Class("text-indigo-500 hover:text-indigo-700 dark:text-indigo-400 dark:hover:text-indigo-300 transition-colors"),
			mi.Style(jumpStyle+";background:none;border:none;padding:0;cursor:pointer"),
			mi.Attr("data-jump-base", "/asset-types"),
			b.Span(mi.Class("material-icons"), mi.Style("font-size:20px;line-height:1;vertical-align:middle"), "info"),
		),
	)
	errNode := b.Span()
	if errMsg != nil && errMsg != "" {
		errNode = b.P(mi.Class("mt-1 text-sm text-red-500"), fmt.Sprintf("%v", errMsg))
	}
	return b.Div(labelNode, b.Select(opts...), errNode)
