		mAttrs := []interface{}{
			mi.Name("svc_medida[]"), mi.Class("px-2 py-1 border border-gray-300 dark:border-gray-600 rounded text-sm bg-white dark:bg-gray-700 w-28"),
			b.Option(mi.Value(""), "Medida"),
		}
		for _, m := range medidaOpts {
			if m == cfg.Medida {
				mAttrs = append(mAttrs, b.Option(mi.Value(m), mi.Selected(), m))
			} else {
				mAttrs = append(mAttrs, b.Option(mi.Value(m), m))
			}
		}
		// alerta select
		aAttrs := []interface{}{
			mi.Name("svc_alerta_id[]"), mi.Class("px-2 py-1 border border-gray-300 dark:border-gray-600 rounded text-sm bg-white dark:bg-gray-700 flex-1"),
			b.Option(mi.Value("0"), "— Alerta —"),
		}
		for _, a := range alertas {
			val := fmt.Sprintf("%d", a.ID)
			label := a.Tipo + " (" + a.Criticidad + ")"
			if a.ID == cfg.AlertaID {
				aAttrs = append(aAttrs, b.Option(mi.Value(val), mi.Selected(), label))
			} else {
				aAttrs = append(aAttrs, b.Option(mi.Value(val), label))
			}
		}
		umbralVal := ""
		if cfg.Umbral != 0 {
			umbralVal = fmt.Sprintf("%g", cfg.Umbral)
		}
		return b.Div(mi.Class(rowClass),
			b.Select(mAttrs...),
			b.Input(mi.Type("number"), mi.Name("svc_umbral[]"),
				mi.Attr("placeholder", "Umbral"), mi.Attr("value", umbralVal),
				mi.Class("px-2 py-1 border border-gray-300 dark:border-gray-600 rounded text-sm bg-white dark:bg-gray-700 w-28")),
			b.Select(aAttrs...),
			b.Button(mi.Type("button"),
				mi.Class("text-red-500 hover:text-red-700 text-sm px-2"),
				mi.Attr("onclick", "this.closest('.svc-config-row').remove()"),
				"✕"),
		)
	}

	rows := []interface{}{}
	for _, cfg := range configs {
		rows = append(rows, buildRow(cfg))
	}
	if len(configs) == 0 {
		rows = append(rows, buildRow(ServiceConfig{}))
	}

	const containerID = "svc_configs_container"
	return b.Div(
		b.Div(append([]interface{}{mi.ID(containerID)}, rows...)...),
		b.Button(mi.Type("button"),
			mi.Class("mt-1 text-sm text-indigo-600 dark:text-indigo-400 hover:underline"),
			mi.Attr("onclick", `
(function(){
  var c=document.getElementById('svc_configs_container');
  var t=c.querySelector('.svc-config-row').cloneNode(true);
  t.querySelectorAll('select').forEach(function(s){s.selectedIndex=0;});
  t.querySelectorAll('input').forEach(function(i){i.value='';});
  c.appendChild(t);
})()`,
			),
			"+ Agregar configuración",
		),
	)
}

// assetTabBtn renders a single tab button in the asset form tab bar.
func assetTabBtn(b *mi.Builder, id, label string, active bool) mi.Node {
	cls := "asset-tab-btn px-4 py-3 text-sm font-medium border-b-2 whitespace-nowrap cursor-pointer transition-colors "
	if active {
		cls += "border-indigo-600 text-indigo-600 dark:text-indigo-400 dark:border-indigo-400"
	} else {
		cls += "border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300"
	}
	return b.Button(
		mi.Type("button"),
		mi.Class(cls),
		mi.Attr("data-tab", id),
		label,
	)
}
