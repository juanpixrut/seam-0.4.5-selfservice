func assetTypeSelectWithHTMX(b *mi.Builder, label, name string, options []AssetTypeOption, errMsg interface{}) mi.Node {
	selClass := "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100"
	var opts []interface{}
	opts = append(opts,
