// DashboardData holds data for the dashboard page.
type DashboardData struct {
	// Urgent / important — top row stat cards
	OpenAlerts        int
	MaintenanceAssets int
	AltaCriticidad    int

	// Urgent / important — panels
	RecentAlerts []DashAlertRow
	Vencimientos []DashVencimientoRow

	// Accessory — below fold
	TotalAssets int
	ByStatus    []DashStatusRow
}

// DashAlertRow is one row in the recent open alerts panel.
type DashAlertRow struct {
	ID         int64
	AssetName  string
	AlertaTipo string
	Criticidad string
	Title      string
	CreatedAt  string
}

// DashVencimientoRow is one row in the upcoming expirations panel.
type DashVencimientoRow struct {
	AssetID   int64
	AssetName string
	Campo     string
	Fecha     string
	DaysLeft  int
}

// DashStatusRow is one status bucket in the accessory breakdown.
type DashStatusRow struct {
	Status string
	Count  int
}

// EventSummary is a brief event used in sensor detail and elsewhere.
type EventSummary struct {
	ID          int64
	AssetName   string
	TriggerType string
	Value       string
	Timestamp   string
}

// AlertSummary is kept for backward compatibility.
type AlertSummary struct {
	ID        int64
	AssetName string
	Message   string
	Severity  string
	Timestamp string
}

func formatNumber(n int) string {
	if n >= 1000000 {
		return formatFloat(float64(n)/1000000) + "M"
	}
	if n >= 1000 {
		return formatFloat(float64(n)/1000) + "K"
	}
	return intToString(n)
}

func formatFloat(f float64) string {
	whole := int(f)
	frac := int((f - float64(whole)) * 10)
	if frac == 0 {
		return intToString(whole)
	}
	return intToString(whole) + "." + intToString(frac)
}

func intToString(n int) string {
	if n == 0 {
		return "0"
	}
	if n < 0 {
		return "-" + intToString(-n)
	}
	var digits []byte
	for n > 0 {
		digits = append([]byte{byte('0' + n%10)}, digits...)
		n /= 10
	}
	return string(digits)
}

// DashboardPage renders the dashboard.
func DashboardPage(data DashboardData, t func(key string, args ...any) string) mi.H {
	if t == nil {
		t = func(key string, args ...any) string { return key }
	}
	return func(b *mi.Builder) mi.Node {
		return b.Div(mi.Class("space-y-6"),
			b.H1(mi.Class("text-2xl font-bold text-gray-900 dark:text-white"), t("nav.dashboard")),

			b.Div(mi.Class("grid grid-cols-1 md:grid-cols-3 gap-4"),
				dashStatCard(b, t("dashboard.open_alerts"), data.OpenAlerts, "/alerts?status=open",
					"crisis_alert", data.OpenAlerts > 0),
				dashStatCard(b, t("dashboard.maintenance"), data.MaintenanceAssets, "/assets?status=maintenance",
					"engineering", false),
				dashStatCard(b, t("dashboard.high_criticality"), data.AltaCriticidad, "/assets?criticidad=Alta",
					"dangerous", data.AltaCriticidad > 0),
			),

			dashRecentAlerts(b, data.RecentAlerts, t),
			dashVencimientos(b, data.Vencimientos, t),

			b.Div(mi.Class("grid grid-cols-1 md:grid-cols-2 gap-4 pt-4 border-t border-gray-200 dark:border-gray-700"),
				dashTotalCard(b, data.TotalAssets, t),
				dashStatusBreakdown(b, data.ByStatus, t),
			),
		)
	}
}

func dashStatCard(b *mi.Builder, label string, count int, href, icon string, urgent bool) mi.Node {
	// Border highlights urgent cards with a non-zero count
	borderClass := "border-gray-200 dark:border-gray-700"
	if urgent && count > 0 {
		borderClass = "border-red-400 dark:border-red-500"
	}
	// Icon accent block: urgent → red tint, neutral → indigo tint
	iconBg, iconFg := "bg-indigo-50 dark:bg-indigo-900/30", "text-indigo-500 dark:text-indigo-400"
	if urgent && count > 0 {
		iconBg, iconFg = "bg-red-50 dark:bg-red-900/30", "text-red-500 dark:text-red-400"
	}
	// Number: urgent non-zero → red, else default
	countClass := "text-3xl font-bold text-gray-900 dark:text-white"
	if urgent && count > 0 {
		countClass = "text-3xl font-bold text-red-600 dark:text-red-400"
	}
	return b.A(mi.Href(href),
		mi.Class("block bg-white dark:bg-gray-800 rounded-lg shadow-sm border-2 "+borderClass+
			" p-6 hover:shadow-md transition-shadow"),
		b.Div(mi.Class("flex items-center gap-4"),
			// Coloured icon block — left anchor, gives card its visual identity
			b.Div(mi.Class("flex-shrink-0 w-12 h-12 rounded-xl flex items-center justify-center "+iconBg),
				b.Span(mi.Class("material-icons text-2xl "+iconFg), icon),
			),
			// Label, number, subtitle
			b.Div(mi.Class("min-w-0"),
				b.Div(mi.Class("text-sm font-medium text-gray-500 dark:text-gray-400 mb-1"), label),
				b.Div(mi.Class(countClass), formatNumber(count)),
			),
		),
	)
}

func dashRecentAlerts(b *mi.Builder, alerts []DashAlertRow, t func(key string, args ...any) string) mi.Node {
	if t == nil {
		t = func(key string, args ...any) string { return key }
	}
	criticidadClass := map[string]string{
		"Alta":  "bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-300",
		"Media": "bg-yellow-100 text-yellow-700 dark:bg-yellow-900/40 dark:text-yellow-300",
		"Baja":  "bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-300",
	}
	header := b.Div(mi.Class("flex items-center justify-between mb-4"),
		b.H2(mi.Class("text-base font-semibold text-gray-900 dark:text-white"), t("dashboard.recent_alerts")),
		b.A(mi.Href("/alerts?status=open"),
			mi.Class("text-sm text-indigo-600 dark:text-indigo-400 hover:underline"), t("dashboard.view_all")),
	)
	if len(alerts) == 0 {
		return b.Div(mi.Class("bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-5"),
			header,
			b.Div(mi.Class("flex items-center gap-3 py-4 text-gray-500 dark:text-gray-400"),
				b.Span(mi.Class("material-icons text-green-500 text-2xl"), "check_circle"),
				b.Span(t("dashboard.no_open_alerts")),
			),
		)
	}
	rows := make([]interface{}, len(alerts))
	for i, a := range alerts {
		cc := criticidadClass[a.Criticidad]
		title := a.Title
		if title == "" {
			title = a.AlertaTipo
		}
		rows[i] = b.A(mi.Href(fmt.Sprintf("/alerts/%d", a.ID)),
			mi.Class("flex items-center justify-between py-3 border-b border-gray-100 dark:border-gray-700 last:border-0 hover:bg-gray-50 dark:hover:bg-gray-700/40 -mx-5 px-5 transition-colors"),
			b.Div(mi.Class("flex items-center gap-3 min-w-0"),
				b.Span(mi.Class("material-icons text-red-500 text-lg flex-shrink-0"), "warning"),
				b.Div(mi.Class("min-w-0"),
					b.Div(mi.Class("text-sm font-medium text-gray-900 dark:text-white truncate"), a.AssetName),
					b.Div(mi.Class("text-xs text-gray-500 dark:text-gray-400"), title),
				),
			),
			b.Div(mi.Class("flex items-center gap-3 flex-shrink-0"),
				b.Span(mi.Class("inline-flex items-center px-2 py-0.5 rounded text-xs font-medium "+cc), a.Criticidad),
				b.Span(mi.Class("text-xs text-gray-400 dark:text-gray-500"), a.CreatedAt),
			),
		)
	}
	return b.Div(mi.Class("bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-5"),
		header,
		b.Div(append([]interface{}{mi.Class("-my-1")}, rows...)...),
	)
}

func dashVencimientos(b *mi.Builder, rows []DashVencimientoRow, t func(key string, args ...any) string) mi.Node {
	if t == nil {
		t = func(key string, args ...any) string { return key }
	}
	header := b.Div(mi.Class("flex items-center justify-between mb-4"),
		b.H2(mi.Class("text-base font-semibold text-gray-900 dark:text-white"), t("dashboard.upcoming_expirations")),
		b.Span(mi.Class("text-xs text-gray-400 dark:text-gray-500"), t("dashboard.next_30_days")),
	)
	if len(rows) == 0 {
		return b.Div(mi.Class("bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-5"),
			header,
			b.Div(mi.Class("py-4 text-sm text-gray-400 dark:text-gray-500 italic"), t("dashboard.no_upcoming_expirations")),
		)
	}
	items := make([]interface{}, len(rows))
	for i, v := range rows {
		urgencyClass := "text-gray-600 dark:text-gray-400"
		daysLabel := t("dashboard.days", v.DaysLeft)
		if v.DaysLeft <= 7 {
			urgencyClass = "text-red-600 dark:text-red-400 font-semibold"
			daysLabel = t("dashboard.days_urgent", v.DaysLeft)
		} else if v.DaysLeft <= 14 {
			urgencyClass = "text-yellow-600 dark:text-yellow-400 font-medium"
		}
		items[i] = b.A(mi.Href(fmt.Sprintf("/assets/%d", v.AssetID)),
			mi.Class("flex items-center justify-between py-3 border-b border-gray-100 dark:border-gray-700 last:border-0 hover:bg-gray-50 dark:hover:bg-gray-700/40 -mx-5 px-5 transition-colors"),
			b.Div(mi.Class("flex items-center gap-3 min-w-0"),
				b.Span(mi.Class("material-icons text-yellow-500 text-lg flex-shrink-0"), "event"),
				b.Div(mi.Class("min-w-0"),
					b.Div(mi.Class("text-sm font-medium text-gray-900 dark:text-white truncate"), v.AssetName),
					b.Div(mi.Class("text-xs text-gray-500 dark:text-gray-400"), t("dashboard.field."+v.Campo)+" · "+v.Fecha),
				),
			),
			b.Span(mi.Class("text-sm flex-shrink-0 "+urgencyClass), daysLabel),
		)
	}
	return b.Div(mi.Class("bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-5"),
		header,
		b.Div(append([]interface{}{mi.Class("-my-1")}, items...)...),
	)
}

func dashTotalCard(b *mi.Builder, total int, t func(key string, args ...any) string) mi.Node {
	if t == nil {
		t = func(key string, args ...any) string { return key }
	}
	return b.Div(mi.Class("bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-6"),
		b.Div(mi.Class("flex items-center gap-4 mb-4"),
			b.Div(mi.Class("flex-shrink-0 w-12 h-12 rounded-xl flex items-center justify-center bg-indigo-50 dark:bg-indigo-900/30"),
				b.Span(mi.Class("material-icons text-2xl text-indigo-500 dark:text-indigo-400"), "inventory_2"),
			),
			b.Div(
				b.Div(mi.Class("text-sm font-medium text-gray-500 dark:text-gray-400 mb-1"), t("dashboard.total_assets")),
				b.Div(mi.Class("text-4xl font-bold text-gray-900 dark:text-white"), formatNumber(total)),
			),
		),
		b.A(mi.Href("/assets"), mi.Class("inline-flex items-center gap-1 text-sm text-indigo-600 dark:text-indigo-400 hover:underline"),
			t("dashboard.view_list")),
	)
}

func dashStatusBreakdown(b *mi.Builder, rows []DashStatusRow, t func(key string, args ...any) string) mi.Node {
	if t == nil {
		t = func(key string, args ...any) string { return key }
	}
	statusLabel := map[string]string{
		"active": t("dashboard.status.active"), "inactive": t("dashboard.status.inactive"),
		"maintenance": t("dashboard.status.maintenance"), "lost": t("dashboard.status.lost"),
	}
	statusColor := map[string]string{
		"active": "bg-green-500", "inactive": "bg-gray-400",
		"maintenance": "bg-yellow-500", "lost": "bg-red-500",
	}
	if len(rows) == 0 {
		return b.Div(mi.Class("bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-5"),
			b.Div(mi.Class("text-sm text-gray-400 dark:text-gray-500 italic"), t("dashboard.no_status_data")),
		)
	}
	items := make([]interface{}, len(rows))
	for i, row := range rows {
		label := statusLabel[row.Status]
		if label == "" {
			label = row.Status
		}
		dot := statusColor[row.Status]
		if dot == "" {
			dot = "bg-gray-300"
		}
		items[i] = b.Div(mi.Class("flex items-center justify-between py-2"),
			b.Div(mi.Class("flex items-center gap-2"),
				b.Span(mi.Class("w-2.5 h-2.5 rounded-full "+dot)),
				b.Span(mi.Class("text-sm text-gray-700 dark:text-gray-300"), label),
			),
			b.Span(mi.Class("text-sm font-medium text-gray-900 dark:text-white"), formatNumber(row.Count)),
		)
	}
	return b.Div(mi.Class("bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-5"),
		b.Div(mi.Class("text-sm font-medium text-gray-500 dark:text-gray-400 mb-3"), t("dashboard.by_status")),
		b.Div(append([]interface{}{mi.Class("divide-y divide-gray-100 dark:divide-gray-700")}, items...)...),
	)
}
