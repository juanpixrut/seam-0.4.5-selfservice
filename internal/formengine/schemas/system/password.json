{
  "type": "object",
  "title": "Change Password",
  "properties": {
    "current_password": {
      "type": "string",
      "title": "Current password",
      "x-seam-input": "password",
      "x-seam-autocomplete": "current-password",
      "minLength": 1
    },
    "new_password": {
      "type": "string",
      "title": "New password",
      "x-seam-input": "password",
      "x-seam-autocomplete": "new-password",
      "x-seam-help": "Minimum 8 characters",
      "x-seam-help-style": "inline",
      "minLength": 8
    },
    "confirm_password": {
      "type": "string",
      "title": "Confirm new password",
      "x-seam-input": "password",
      "x-seam-autocomplete": "new-password"
    }
  },
  "required": [
    "current_password",
    "new_password",
    "confirm_password"
  ]
}
